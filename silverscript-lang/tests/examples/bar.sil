pragma silverscript ^0.1.0;

contract Bar(byte[32] pkh_bar) {
    function funcA() {
        require(2 == 2);
    }

    function funcB() {
        require(2 == 2);
    }

    entry execute(pubkey pk, sig s) {
        require(blake2b(byte[](pk)) == pkh_bar);
        require(checkSig(s, pk));
    }
}
