pragma silverscript ^0.1.0;

contract Contract(
    pubkey ownerPk,
    pubkey oraclePk,
) {
    entry spend(
        sig ownerSig,
        datasig oracleMsgSig,
        sig oracleTxSig,
    ) {
        byte[] oracleMessage = byte[]('Spend') + (12 as byte[8]);
        require(checkSigFromStack(
            oracleMsgSig,
            sha256(oracleMessage),
            oraclePk,
        ));
        require(checkMultiSig([
            ownerSig,
            oracleTxSig,
        ], [
            ownerPk,
            oraclePk,
        ]));
    }
}
